# Copy to .env or export in your shell. NEVER commit a real key.
# Leave both keys empty to run in DEMO mode (local rule-based analyzer).

# Gemini (primary provider for this project; used first if set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (optional alternative; used if no Gemini key is set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Flask server port
PORT=5000
